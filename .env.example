# Copy this file to .env on your Linux server and fill in the values.
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me

# Optional. Only needed when Feishu custom bot signature verification is enabled.
# FEISHU_SECRET=replace-me

# Optional runtime settings for scripts/run_feishu.sh
COLLECT_LIMIT=30
PUSH_LIMIT=20
PYTHON_BIN=python3

# Optional cleanup automation. CLEANUP_SCHEDULE can be weekly, monthly, or none.
CLEANUP_SCHEDULE=weekly
CLEANUP_RETENTION_DAYS=30
CLEANUP_VACUUM=false

# Optional AI settings. Use AI_PROVIDER=anthropic for Anthropic-compatible gateways.
ENABLE_AI=false
# AI_PROVIDER=anthropic
# OPENAI_BASE_URL=https://example.com/anthropic
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=replace-me
# AI_MAX_TOKENS=8192
